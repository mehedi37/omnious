{
  "name": "omnious",
  "version": "0.1.0",
  "packageManager": "npm@11.7.0",
  "private": true,
  "description": "Omnious — Visual Debugging Platform for the Vibe Coding Era",
  "workspaces": [
    "packages/shared",
    "frontend",
    "backend",
    "cli",
    "mcp"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "start": "turbo run start --filter=!@omnious/mcp --filter=!@omnious/cli",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:types": "npm run db:types --workspace=@omnious/backend"
  },
  "devDependencies": {
    "immer": "^11.1.4",
    "turbo": "^2.9.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "zustand": "5.0.11"
  }
}
