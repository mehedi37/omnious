# ═══════════════════════════════════════════════════════════════=
# Omnious — Environment Variables=
# Copy to .env and fill in your values=
# ═══════════════════════════════════════════════════════════════=
# ─── Supabase (REQUIRED) ──────────────────────────────────────=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# ─── Server ───────────────────────────────────────────────────=
NODE_ENV=
FRONTEND_PORT=
BACKEND_PORT=
LOG_LEVEL=
# ─── Public URLs (used in docker-compose) ─────────────────────=
# The URL your frontend is accessible at (for CORS, callbacks)=
PUBLIC_FRONTEND_URL=
# The URL your backend API is accessible at (for frontend API calls)=
PUBLIC_API_URL=
# CORS origins (comma-separated, frontend URL + any others)=
CORS_ORIGINS=
# ─── Stripe (optional — billing not enforced until enabled) ───=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# ─── AI (optional — platform-level AI features) ──────────────=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ─── Security (optional — can be added later) ────────────────=
# 32-byte hex string for BYOK AES-256-GCM encryption=
ENCRYPTION_MASTER_KEY=
# Cloudflare Turnstile (bot protection on auth pages)=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# ─── Feature Flags (optional) ────────────────────────────────=
# Set to 'true' to enforce billing/plan limits=
ENABLE_BILLING=