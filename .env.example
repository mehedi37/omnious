# ═══════════════════════════════════════════════════════════════
# Omnious — Environment Variables (single source of truth)
# cp .env.example .env  →  fill in your values
# ═══════════════════════════════════════════════════════════════
#
# This ONE file is loaded by ALL packages in the monorepo:
#   • backend  — via dotenv path resolution in src/config/env.ts
#   • frontend — via `next dev --env-file ../.env`
#   • docker   — docker-compose reads from root .env natively
#
# ─── Supabase (REQUIRED) ──────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Public aliases — same values, required by Next.js browser bundles
# (NEXT_PUBLIC_* vars are inlined at build time by Next.js)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
FRONTEND_PORT=3000
BACKEND_PORT=4000
# info | warn | error | debug | trace | fatal
LOG_LEVEL=info

# ─── URLs ─────────────────────────────────────────────────────
# Backend API URL — consumed by Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
# Allowed CORS origins for the backend (comma-separated)
CORS_ORIGINS=http://localhost:3000

# ─── AI Platform Keys (optional) ─────────────────────────────
# Platform-level fallback for users who haven't added BYOK keys.
# If unset, only BYOK users can run AI features.
#
# • OpenAI:    https://platform.openai.com/account/api-keys
# • Anthropic: https://console.anthropic.com/account/keys
# • Groq:      https://console.groq.com/keys  (BYOK only — no platform fallback)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Security (REQUIRED for BYOK key storage) ────────────────
# AES-256-GCM master key — 64 hex chars = 32 bytes
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=

# ─── Feature Flags ────────────────────────────────────────────
# Set to 'true' to enforce plan/billing limits
ENABLE_BILLING=false