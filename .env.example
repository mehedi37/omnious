# ═══════════════════════════════════════════════════════════════
# Omnious — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Supabase (REQUIRED) ──────────────────────────────────────
SUPABASE_URL=your-supabase_url
SUPABASE_ANON_KEY=your-supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your-supabase_service_role_key
SUPABASE_JWT_SECRET=your-supabase_jwt_secret
# Public aliases — same values, required by Next.js browser bundles
NEXT_PUBLIC_SUPABASE_URL=your-next_public_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-next_public_supabase_anon_key

# ─── Server ───────────────────────────────────────────────────
# development | production
# NODE_ENV=your-# node_env # Do not set in .env - Next.js sets this automatically during build
PORT=your-port
HOST=your-host
FRONTEND_PORT=your-frontend_port
BACKEND_PORT=your-backend_port
# info | warn | error | debug | trace | fatal
LOG_LEVEL=your-log_level

# ─── URLs ─────────────────────────────────────────────────────
# Backend URL (used by frontend to reach the API)
NEXT_PUBLIC_API_URL=your-next_public_api_url
# CORS origins allowed by the backend (comma-separated)
CORS_ORIGINS=your-cors_origins

# ─── AI (Ollama local runtime) ───────────────────────────────
# Local development: Ollama on the same machine as the backend
OLLAMA_BASE_URL=http://localhost:11434/v1

# Docker deployment: backend container → Ollama on the host machine
# On Linux, start Ollama with: OLLAMA_HOST=0.0.0.0:11434 ollama serve
# Then set OLLAMA_BASE_URL_DOCKER to the host-gateway address below
OLLAMA_BASE_URL_DOCKER=http://host.docker.internal:11434/v1
OLLAMA_HOST=0.0.0.0:11434

# Models — pull with: ollama pull gemma4:latest && ollama pull nomic-embed-text-v2-moe
OLLAMA_MODEL=gemma4:latest
OLLAMA_MODEL_FAST=gemma4:latest
OLLAMA_MODEL_POWERFUL=gemma4:latest
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
# Must match the model's actual output dimensions (768 for nomic-embed-text-v2-moe)
OLLAMA_EMBEDDING_DIMENSIONS=768
# Leave as "ollama" unless your Ollama instance requires authentication
OLLAMA_API_KEY=ollama

# BYOK providers are disabled for local testing (kept for future re-enable)
ENABLE_BYOK_AI=your-enable_byok_ai
# OPENAI_API_KEY=your-# openai_api_key
# ANTHROPIC_API_KEY=your-# anthropic_api_key

# ─── Security ────────────────────────────────────────────────
# AES-256-GCM master key for encrypting stored BYOK API keys (64 hex chars =your-# aes-256-gcm master key for encrypting stored byok api keys (64 hex chars
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=your-api_key_encryption_key

# ─── Feature Flags ────────────────────────────────────────────
ENABLE_BILLING=your-enable_billing
