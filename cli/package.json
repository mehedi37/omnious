{
  "name": "@omnious/cli",
  "version": "0.1.0",
  "description": "Omnious CLI — code intelligence from your terminal",
  "type": "module",
  "bin": {
    "omnious": "./dist/bin/omnious.js"
  },
  "scripts": {
    "build": "tsup",
    "build:prod": "OMNIOUS_PROD_URL=https://api.omnious.dev tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured yet'",
    "clean": "rm -rf dist .omnious",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@omnious/shared": "*",
    "@inquirer/prompts": "^7.5.1",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "glob": "^11.0.1",
    "ignore": "^7.0.4",
    "ora": "^8.2.0",
    "tree-sitter": "^0.22.4",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-typescript": "^0.23.2",
    "yaml": "^2.7.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsup": "^8.5.0",
    "vitest": "^4.0.18"
  },
  "keywords": [
    "omnious",
    "cli",
    "code-graph",
    "oir",
    "ast",
    "tree-sitter",
    "debugging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mehedi37/omnious",
    "directory": "cli"
  }
}
